@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Add Expense";
    var currentUser = Context.Session.GetString("Username") ?? "";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="text-center mb-4">
                <h2 class="fw-bold" style="letter-spacing: -0.03em;">Log New Transaction</h2>
                <p class="text-muted small">Record shared expenses, define participants, and track payments.</p>
            </div>

            <div class="card border-0 shadow-sm p-4 rounded-4">
                <form id="expenseForm">
                    <div class="mb-4">
                        <label class="form-label small text-muted fw-bold">DESCRIPTION</label>
                        <input type="text" id="Title" class="form-control shadow-none" placeholder="Dinner, Uber, Groceries..." required />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">TOTAL AMOUNT (€)</label>
                            <input id="Amount" type="number" step="0.01" class="form-control shadow-none" placeholder="0.00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">DATE</label>
                            <input id="Date" type="datetime-local" class="form-control shadow-none" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted fw-bold">SPLIT METHOD</label>
                            <select id="SplitType" class="form-select shadow-none">
                                <option value="0">Equal Split</option>
                                <option value="1">Exact Amount Split</option>
                                <option value="2">Percentage Split</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-5 p-3 border rounded">
                        <label class="form-label mb-3 fw-bold">Participants</label>
                        
                        <table class="table table-borderless table-sm mb-2" id="participantsTable">
                            <thead>
                                <tr class="border-bottom" style="font-size: 0.85rem; color: #6c757d;">
<th style="width: 55%;">PARTICIPANT USERNAME</th>
            <th style="width: 30%;">SHARE</th>
            <th style="width: 15%; text-center"></th>                                
            </tr>
                            </thead>
                            <tbody>
                                </tbody>
                        </table>
                        <div id="splitValuesContainer" class="mb-4"></div>

                        
                        <button type="button" class="btn btn-outline-dark btn-sm mt-2" id="addParticipantBtn">
                            <i class="bi bi-person-plus me-1"></i> Add Participant
                        </button>
                    </div>

                    <div id="errorSummary" class="alert alert-danger py-2 small mb-4 d-none"></div>

                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold rounded-3">
                        <i class="bi bi-check-lg me-2"></i> Save Expense
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const editId = urlParams.get('editId'); //check edit mode
        const currentUser = "@currentUser";

        if (!currentUser) window.location.href = '/User/Login';

        const participantsTableBody = document.querySelector("#participantsTable tbody");
        const errorBox = document.getElementById('errorSummary');

        

        function addParticipantRow(username = "", isFixed = false) {
    const row = document.createElement("tr");
   row.innerHTML = `
        <td class="position-relative">
            <input class="form-control username-input" 
                value="${username}" 
                autocomplete="off"
                ${isFixed ? 'readonly style="background-color: #f8f9fa;"' : ''} 
                placeholder="Enter username" required />
            <div class="autocomplete-suggestions list-group position-absolute w-100 shadow-sm d-none" 
                style="z-index: 1000; max-height: 200px; overflow-y: auto; top: 100%;">
            </div>
        </td>
        <td class="align-middle">
            <input type="number" min="0" step="0.01" class="form-control split-value-input" 
                placeholder="${splitTypeSelect.value == '2' ? 'Percentage' : 'Amount'}"
                ${splitTypeSelect.value == '0' ? 'readonly style="background-color:#e9ecef;"' : ''} />
        </td>
        <td class="align-middle text-center">
            ${isFixed ? 
                '<span class="badge bg-light text-dark border">You</span>' : 
                '<button type="button" class="btn btn-sm btn-outline-danger removeBtn">&times;</button>'}
        </td>
    `;
    participantsTableBody.appendChild(row);

    const input = row.querySelector(".username-input");
    const suggestionsBox = row.querySelector(".autocomplete-suggestions");
    const splitInput = row.querySelector(".split-value-input");

    if (!isFixed) {
        let timeout = null;

        input.addEventListener("input", () => {
            clearTimeout(timeout);
            const term = input.value.trim();

            if (term.length < 3) {
                suggestionsBox.classList.add("d-none");
                return;
            }

            timeout = setTimeout(async () => {
                try {
                    const res = await fetch(`/api/userapi/search?term=${encodeURIComponent(term)}`);
                    if (res.ok) {
                        const users = await res.json();
                        if (users.length > 0) {
                            suggestionsBox.innerHTML = users.map(u => `
                                <button type="button" class="list-group-item list-group-item-action py-2 small">
                                    ${u}
                                </button>
                            `).join('');
                            suggestionsBox.classList.remove("d-none");

                            suggestionsBox.querySelectorAll("button").forEach(btn => {
                                btn.onclick = () => {
                                    input.value = btn.innerText.trim();
                                    suggestionsBox.classList.add("d-none");
                                    splitInput.placeholder = splitTypeSelect.value == '2' ? 'Percentage' : 'Amount';
                                };
                            });
                        } else {
                            suggestionsBox.classList.add("d-none");
                        }
                    }
                } catch (err) {
                    console.error("Search error:", err);
                }
            }, 300);
        });

        document.addEventListener("click", (e) => {
            if (!row.contains(e.target)) suggestionsBox.classList.add("d-none");
        });

        row.querySelector(".removeBtn").onclick = () => {
            row.remove();
        };
    }
}



    async function loadExistingData() {
        if (!editId) {
            addParticipantRow(currentUser, true);
            return;
        }

            const res = await fetch(`/api/expenseapi/${editId}`);
            if (res.ok) {
                const data = await res.json();
                document.getElementById('Title').value = data.name;
                document.getElementById('Amount').value = data.totalAmount;
                if (data.timestamp) {
                    // Replace space with T and take only YYYY-MM-DDTHH:mm
                    document.getElementById('Date').value = data.timestamp.replace(' ', 'T').slice(0, 16);
                }
                document.getElementById('SplitType').value = data.splitType || 0;
                
                participantsTableBody.innerHTML = ""; 
                data.participants.forEach(p => {
                    addParticipantRow(p.username, p.username === currentUser);
                });
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (!editId) {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            
            const localDateTime = `${year}-${month}-${day}T${hours}:${minutes}`;
            
            document.getElementById('Date').value = localDateTime;
            addParticipantRow(currentUser, true);
            } else {
                loadExistingData();
            }
        });

        document.getElementById("addParticipantBtn").onclick = () => addParticipantRow();

        document.getElementById('expenseForm').onsubmit = async function (e) {
            e.preventDefault();
            errorBox.classList.add('d-none');

            const inputs = document.querySelectorAll(".username-input");
            const participantObjects = Array.from(inputs).map(input => ({
                username: input.value.trim()
            }));

            const usernames = participantObjects.map(p => p.username);
            const hasDuplicates = usernames.some((name, index) => usernames.indexOf(name) !== index);

            if (hasDuplicates) {
                errorBox.innerText = "Error: You cannot add the same participant twice.";
                errorBox.classList.remove('d-none');
                return; 
            }

            // Gather split values
            const splitValues = Array.from(document.querySelectorAll(".split-value-input"))
                .map(input => parseFloat(input.value));
            const splitType = document.getElementById("SplitType").value;

            if (splitType === "1" || splitType === "2") { 
                if (splitValues.some(val => isNaN(val) || val <= 0)) {
                    errorBox.innerText = "Please provide a valid amount/percentage for all participants.";
                    errorBox.classList.remove('d-none');
                    return;
                }
                
                if (splitType === "1") {
                    const total = parseFloat(document.getElementById('Amount').value);
                    const sum = splitValues.reduce((a, b) => a + b, 0);
                    if (Math.abs(total - sum) > 0.01) {
                        errorBox.innerText = `The sum of shares (${sum}) must equal the total amount (${total}).`;
                        errorBox.classList.remove('d-none');
                        return;
                    }
                }
            }

            const payload = {
                title: document.getElementById('Title').value,
                amount: parseFloat(document.getElementById('Amount').value),
                timestamp: document.getElementById('Date').value,
                splitType: parseInt(document.getElementById('SplitType').value),
                participants: participantObjects,
                splitValues: splitValues.length > 0 ? splitValues : null
            };

            console.log(payload);
            const method = editId ? 'PUT' : 'POST';
            const url = editId ? `/api/expenseapi/${editId}` : '/api/expenseapi';

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    window.location.href = '/Expense/Index';
                } else if (response.status === 401) {
                    window.location.href = '/User/Login';
                } else {
                    const data = await response.json();
                    errorBox.innerText = data.message || "Error saving expense. Check all fields.";
                    errorBox.classList.remove('d-none');
                }
            } catch (err) {
                errorBox.innerText = "Connection failed.";
                errorBox.classList.remove('d-none');
            }
        };


        const splitTypeSelect = document.getElementById("SplitType");
        const splitValuesContainer = document.getElementById("splitValuesContainer");

    function renderSplitInputs() {
        const participantRows = document.querySelectorAll("#participantsTable tbody tr");

        participantRows.forEach(row => {
            const splitInput = row.querySelector(".split-value-input");
            if (!splitInput) return;

            splitInput.placeholder = splitTypeSelect.value == '2' ? 'Percentage' : 'Amount';

            if (splitTypeSelect.value == '0') {
                // Equal split: disable input
                splitInput.value = '';
                splitInput.readOnly = true;
                splitInput.style.backgroundColor = '#e9ecef';
            } else {
                // Exact or Percentage: enable input
                splitInput.readOnly = false;
                splitInput.style.backgroundColor = '';
            }
        });
    }



        // Update inputs whenever split type or participants change
        splitTypeSelect.addEventListener("change", renderSplitInputs);
        document.getElementById("addParticipantBtn").addEventListener("click", () => {
            setTimeout(renderSplitInputs, 50); // wait for new participant row to render
        });

    </script>
}