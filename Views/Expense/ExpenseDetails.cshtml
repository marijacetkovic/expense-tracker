@model int
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Expense Details";
    var currentUserId = Context.Session.GetInt32("UserId") ?? 0;
}

<div class="container mt-5 mb-5" style="max-width: 700px;">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Expense/Index" class="text-dark text-decoration-none">History</a></li>
            <li class="breadcrumb-item active">Expense Details</li>
        </ol>
    </nav>

    <div id="loadingIndicator" class="text-center py-5">
        <div class="spinner-border text-dark" role="status"></div>
        <p class="text-muted mt-2">Fetching transaction details...</p>
    </div>

    <div id="detailsCard" class="d-none">
        <div class="card border-0 shadow-sm p-5 rounded-4">
            <div class="text-center mb-5">
                <h1 id="expenseName" class="fw-bold mb-2"></h1>
                <p id="expenseDate" class="text-muted small text-uppercase tracking-wider"></p>
                <div id="totalAmount" class="display-4 fw-bold mt-4"></div>
            </div>

            <h6 class="fw-bold text-uppercase small text-muted mb-3 border-bottom pb-2">Breakdown</h6>
            
            <div id="participantsList" class="list-group list-group-flush mb-4">
                </div>

            <div id="userShareSection" class="bg-light p-4 rounded-3 text-center mb-4 d-none">
                <p class="small text-muted mb-1">Your individual responsibility</p>
                <h3 id="userShareValue" class="fw-bold mb-0"></h3>
            </div>

            <div id="ownerActions" class="mt-4 d-flex gap-2 d-none">
                <button id="editBtn" class="btn btn-dark flex-grow-1 py-3 fw-bold rounded-3">
                    <i class="bi bi-pencil-square me-2"></i>Edit Expense
                </button>
                <button type="button" class="btn btn-outline-danger px-4 rounded-3" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash me-2"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg p-4 rounded-4">
            <h5 class="fw-bold mb-3">Delete Expense?</h5>
            <p class="text-muted small">This will permanently remove this expense and all associated splits. This cannot be undone.</p>
            <div class="d-flex gap-2 mt-4">
                <button type="button" class="btn btn-light flex-grow-1 py-2" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger flex-grow-1 py-2">Delete Permanently</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const expenseId = @Model;
        const currentUserId = @currentUserId;

        async function fetchExpenseDetails() {
            try {
                const response = await fetch(`/api/expenseapi/${expenseId}`);
                
                if (response.status === 401) {
                    window.location.href = '/User/Login';
                    return;
                }
                if (!response.ok) throw new Error("Expense not found");

                const data = await response.json();

                document.getElementById('expenseName').innerText = data.name;
                document.getElementById('expenseDate').innerText = new Date(data.timestamp).toLocaleDateString('en-US', { 
                    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' ,
                    hour: '2-digit', minute: '2-digit'
                });
                document.getElementById('totalAmount').innerText = `€${data.totalAmount.toFixed(2)}`;

                const list = document.getElementById('participantsList');
                list.innerHTML = data.participants.map(p => {
                    // Identifying owner based on the createdByUserId from the main expense object
                    const isOwner = data.createdByUserId === p.userId; 
                    return `
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 px-0">
                            <div>
                                <span class="fw-medium ${p.isCurrentUser ? "text-primary" : ""}">
                                    ${p.username} ${p.isCurrentUser ? "(You)" : ""}
                                </span>
                                ${isOwner ? '<span class="badge bg-dark-subtle text-dark ms-2 fw-normal" style="font-size: 0.7rem;">OWNER</span>' : ''}
                            </div>
                            <span class="fw-bold">€${p.shareAmount.toFixed(2)}</span>
                        </div>
                    `;
                }).join('');

                // 3. User Individual Share
                if (data.userShare !== undefined && data.userShare !== null) {
                    document.getElementById('userShareSection').classList.remove('d-none');
                    document.getElementById('userShareValue').innerText = `€${data.userShare.toFixed(2)}`;
                }

                if (data.createdByUserId === currentUserId) {
                    document.getElementById('ownerActions').classList.remove('d-none');
                    document.getElementById('editBtn').onclick = () => {
                        // Redirecting to the form with the editId parameter
                        window.location.href = `/Expense/ExpenseForm?editId=${expenseId}`;
                    };
                }

                // Toggle visibility
                document.getElementById('loadingIndicator').classList.add('d-none');
                document.getElementById('detailsCard').classList.remove('d-none');

            } catch (err) {
                document.getElementById('loadingIndicator').innerHTML = `
                    <div class="alert alert-danger mx-auto" style="max-width: 400px;">
                        <i class="bi bi-exclamation-triangle me-2"></i>${err.message}
                    </div>
                `;
            }
        }


        document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
            try {
                const res = await fetch(`/api/expenseapi/${expenseId}`, { method: 'DELETE' });
                if (res.ok) {
                    window.location.href = '/Expense/Index';
                } else {
                    const errorData = await res.json();
                    alert(errorData.message || "Failed to delete expense.");
                }
            } catch (err) {
                alert("Connection error. Could not delete.");
            }
        });

        document.addEventListener("DOMContentLoaded", fetchExpenseDetails);
    </script>
}